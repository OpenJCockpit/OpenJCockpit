OPENAI_API_KEY=your-openai-api-key-here

# --- Local Ollama (optional; both have working defaults) -----------------------------------
# The agent pipeline's default LLM runs on YOUR machine's Ollama daemon. Install Ollama on the
# host and run `ollama pull qwen3.6:27b` BEFORE starting the stack.
#
# Base URL of the Ollama daemon.
#   docker compose default : http://host.docker.internal:11434  (the host, via Docker's gateway)
#   host-run default       : http://localhost:11434
# Only set this if your Ollama listens elsewhere. Setting it here applies to the CONTAINER, so a
# value of http://localhost:11434 will break the containerized service.
# OLLAMA_BASE_URL=http://host.docker.internal:11434
#
# Ollama model tag. Must exist in `ollama list`. Default: qwen3.6:27b
# OLLAMA_MODEL=qwen3.6:27b
# --- LiteLLM gateway (local development only) ---------------------------------------------
# The default/coding LLM now goes through the LiteLLM container, which in turn calls YOUR
# host's Ollama daemon. Admin UI: http://localhost:4100
# ALL of the values below are LOCAL-TESTING-ONLY seed credentials (CLAUDE.md seed exception).
# Never reuse them in CI, staging or production.
# LITELLM_MASTER_KEY=sk-metafactory-litellm-local
# LITELLM_SALT_KEY=sk-metafactory-litellm-salt-local     # changing this invalidates stored credentials
# LITELLM_VIRTUAL_KEY=sk-metafactory-embabel-local       # the key embabel-agent-service presents
# LITELLM_UI_USERNAME=ricky
# LITELLM_UI_PASSWORD=Welkom01!
#
# Revert B (BR-14): route the default/coding LLM straight at host Ollama again,
# bypassing the gateway. Configuration only -- no rebuild, no compose edit.
# LLM_CODING_ROUTE=direct
