{
  "realm": "openjcockpit",
  "displayName": "OpenJCockpit",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "openjcockpit-admin",
        "description": "OpenJCockpit administrator: everything, including project, git-credential, OPA, integration, skills-marketplace and A2A configuration. Implies operator, approver and viewer."
      },
      {
        "name": "openjcockpit-operator",
        "description": "OpenJCockpit operator: start/stop workflow runs; manage workflows, definitions, specs and spec queues. Implies viewer."
      },
      {
        "name": "openjcockpit-approver",
        "description": "OpenJCockpit approver: decide workflow approval gates. Implies viewer."
      },
      {
        "name": "openjcockpit-viewer",
        "description": "OpenJCockpit viewer: read-only access to the dashboard API."
      }
    ]
  },
  "clients": [
    {
      "clientId": "openjcockpit",
      "name": "openjcockpit",
      "description": "OpenJCockpit dashboard SPA (hub and dashboard)",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "bearerOnly": false,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "rootUrl": "http://localhost:4000",
      "baseUrl": "/",
      "adminUrl": "http://localhost:4000",
      "redirectUris": [
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*",
        "http://localhost:4000/*",
        "http://127.0.0.1:4000/*"
      ],
      "webOrigins": [
        "http://localhost:5173",
        "http://127.0.0.1:5173",
        "http://localhost:4000",
        "http://127.0.0.1:4000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "+"
      },
      "defaultClientScopes": [
        "web-origins",
        "acr",
        "roles",
        "profile",
        "basic",
        "email"
      ],
      "optionalClientScopes": [
        "address",
        "phone",
        "offline_access",
        "microprofile-jwt"
      ]
    }
  ],
