server {
  listen 8080;
  server_name _;

  root /usr/share/nginx/html;

  gzip on;
  gzip_vary on;
  gzip_comp_level 5;
  gzip_min_length 1024;
  gzip_proxied any;
  gzip_types text/css text/javascript application/javascript application/json;

  # The host loads this remote's code cross-origin. add_header in a location drops inherited headers,
  # so every location repeats the CORS and nosniff lines.

  # Hashed chunks never change.
  location /assets/ {
    add_header Access-Control-Allow-Origin "${HOST_ORIGIN}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Cache-Control "public, max-age=31536000, immutable";
    try_files $uri =404;
  }

  # The manifest and entry name the current chunks, so they are revalidated on every load. A missing
  # *.js or *.json is a plain 404: an HTML fallback would be parsed as JavaScript or JSON and mask the failure.
  location ~ ^/(mf-manifest\.json|mf-stats\.json|remoteEntry\.js)$ {
    add_header Access-Control-Allow-Origin "${HOST_ORIGIN}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Cache-Control "no-store";
    try_files $uri =404;
  }

  location = /healthz {
    access_log off;
    default_type text/plain;
    return 200 "ok\n";
  }

  location = /version.json {
    default_type application/json;
    add_header Cache-Control "no-store";
    return 200 '{"sha":"${BUILD_SHA}"}';
  }

  location / {
    return 404;
  }
}
