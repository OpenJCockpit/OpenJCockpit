    "visual:baseline": "node visual/run.mjs baseline",
    "visual:check": "node visual/run.mjs check"
  },
  "dependencies": {
    "@openjcockpit/api": "*",
    "@openjcockpit/auth": "*",
    "@openjcockpit/landing-hub": "*",
