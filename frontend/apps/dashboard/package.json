{
  "name": "openjcockpit-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . --ignore-path ../../.prettierignore",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore",
    "check:styles": "node visual/check-classes.mjs",
    "check:bundle": "node scripts/check-bundle-size.mjs",
    "visual:baseline": "node visual/run.mjs baseline",
    "visual:check": "node visual/run.mjs check"
  },
  "dependencies": {
    "@openjcockpit/api": "*",
    "@openjcockpit/auth": "*",
    "@openjcockpit/landing-hub": "*",
    "@openjcockpit/project": "*",
    "@openjcockpit/skills-hub": "*",
    "@openjcockpit/spec-files": "*",
    "@openjcockpit/spec-queue": "*",
    "@openjcockpit/ui": "*",
    "@openjcockpit/workflow": "*",
    "@tanstack/react-query": "5.104.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router": "7.18.4"
  },
  "nx": {
    "includedScripts": []
  }
}
