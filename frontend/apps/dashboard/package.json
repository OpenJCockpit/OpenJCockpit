{
  "name": "openjcockpit-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:styles": "node visual/check-classes.mjs",
    "visual:baseline": "node visual/run.mjs baseline",
    "visual:check": "node visual/run.mjs check"
  },
  "dependencies": {
    "@openjcockpit/api": "*",
    "@openjcockpit/auth": "*",
    "@openjcockpit/landing-hub": "*",
    "@openjcockpit/project": "*",
    "@openjcockpit/skills-hub": "*",
    "@openjcockpit/spec-files": "*",
    "@openjcockpit/spec-queue": "*",
    "@openjcockpit/ui": "*",
    "@openjcockpit/workflow": "*",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "nx": {
    "includedScripts": []
  }
}
