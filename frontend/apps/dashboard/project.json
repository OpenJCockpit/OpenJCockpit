{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "dashboard",
  "projectType": "application",
  "sourceRoot": "apps/dashboard/src",
  "tags": ["type:app"],
  "targets": {
    "format-check": {
      "executor": "nx:run-script",
      "options": {
        "script": "format:check"
      }
    },
    "check-styles": {
      "executor": "nx:run-script",
      "options": {
        "script": "check:styles"
      }
    },
    "visual-baseline": {
      "executor": "nx:run-script",
      "options": {
        "script": "visual:baseline"
      }
    },
    "visual-check": {
      "executor": "nx:run-script",
      "options": {
        "script": "visual:check"
      }
    },
    "check-bundle": {
      "executor": "nx:run-script",
      "options": {
        "script": "check:bundle"
      },
      "dependsOn": ["build"]
    },
    "coverage": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run --coverage",
        "cwd": "{projectRoot}"
      }
    }
  }
}
