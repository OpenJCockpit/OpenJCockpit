{
  "name": "openjcockpit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "nx run-many -t lint",
    "typings": "typed-scss-modules \"{libs,apps}/**/*.module.scss\" --exportType default --nameFormat camel --logLevel error",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "coverage": "nx run-many -t coverage",
    "build": "nx run dashboard:build",
    "check": "nx run-many -t lint typecheck test format-check check-styles check-i18n",
    "affected": "nx affected -t lint typecheck test build",
    "start:hub": "nx run-many -t dev -p dashboard,remote-hello,remote-skills-hub,remote-specs --parallel=4",
    "start:hub:mock": "MOCK_API=1 nx run-many -t dev -p dashboard,remote-hello,remote-skills-hub,remote-specs --parallel=4",
    "build:hub": "nx run-many -t build -p remote-hello,remote-skills-hub,remote-specs,dashboard"
  },
  "nx": {
    "includedScripts": [
      "typings"
    ]
  },
  "workspaces": [
    "apps/*",
    "libs/*",
    "e2e"
  ],
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint/js": "9.39.5",
    "@module-federation/vite": "1.23.7",
    "@nx/eslint": "23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/vite": "23.3.0",
    "@nx/vitest": "23.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.14.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-i18next": "6.1.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "25.0.1",
    "nx": "23.3.0",
    "prettier": "3.9.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sass": "1.104.0",
    "typed-scss-modules": "8.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "6.4.5",
    "vitest": "4.1.11",
    "vitest-axe": "0.1.0"
  }
}
