{
  "name": "openjcockpit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "lint": "nx run-many -t lint",
    "typecheck": "nx run-many -t typecheck",
    "test": "nx run-many -t test",
    "build": "nx run dashboard:build",
    "check": "nx run-many -t lint typecheck test format-check check-styles",
    "affected": "nx affected -t lint typecheck test build"
  },
  "workspaces": [
    "apps/dashboard",
    "libs/*",
    "e2e"
  ],
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint/js": "9.39.5",
    "@nx/eslint": "^23.3.0",
    "@nx/eslint-plugin": "23.3.0",
    "@nx/vite": "^23.3.0",
    "@nx/vitest": "^23.3.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "jsdom": "25.0.1",
    "nx": "23.3.0",
    "prettier": "3.9.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sass": "1.104.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "6.4.4",
    "vitest": "4.1.11"
  }
}
