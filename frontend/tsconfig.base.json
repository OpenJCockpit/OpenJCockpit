{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "paths": {
      "@openjcockpit/api": ["./libs/api/src/index.ts"],
      "@openjcockpit/api/testing": ["./libs/api/src/testing/index.ts"],
      "@openjcockpit/auth": ["./libs/auth/src/index.ts"],
      "@openjcockpit/landing-hub": ["./libs/landing-hub/src/index.ts"],
      "@openjcockpit/project": ["./libs/project/src/index.ts"],
      "@openjcockpit/skills-hub": ["./libs/skills-hub/src/index.ts"],
      "@openjcockpit/spec-files": ["./libs/spec-files/src/index.ts"],
      "@openjcockpit/spec-queue": ["./libs/spec-queue/src/index.ts"],
      "@openjcockpit/ui": ["./libs/ui/src/index.ts"],
      "@openjcockpit/workflow": ["./libs/workflow/src/index.ts"]
    }
  }
}
