{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "main",
  "analytics": false,
  "plugins": [
    { "plugin": "@nx/eslint/plugin", "options": { "targetName": "lint" } },
    {
      "plugin": "@nx/vite/plugin",
      "options": {
        "buildTargetName": "build",
        "serveTargetName": "dev",
        "previewTargetName": "preview",
        "typecheckTargetName": "typecheck"
      }
    },
    { "plugin": "@nx/vitest", "options": { "testTargetName": "test" } }
  ],
  "cacheDirectory": ".nx/cache",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/eslint.config.base.js",
      "{workspaceRoot}/vite.config.base.ts",
      "{workspaceRoot}/.prettierrc.json",
      "{workspaceRoot}/.prettierignore",
      "{workspaceRoot}/package-lock.json"
    ],
    "production": ["default", "!{projectRoot}/**/*.test.{ts,tsx}", "!{projectRoot}/visual/**/*"]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"]
    },
    "typings": { "cache": false },
    "lint": {
      "cache": true,
      "inputs": ["default"],
      "dependsOn": [{ "projects": ["openjcockpit"], "target": "typings" }]
    },
    "test": { "cache": true, "inputs": ["default"] },
    "format-check": { "cache": true, "inputs": ["default"] },
    "check-styles": {
      "cache": true,
      "inputs": ["default", "{workspaceRoot}/libs/**/*.{scss,ts,tsx,mjs}"]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default"],
      "dependsOn": [{ "projects": ["openjcockpit"], "target": "typings" }]
    },
    "coverage": {
      "cache": true,
      "inputs": ["default"],
      "outputs": ["{projectRoot}/coverage"]
    }
  }
}
