# OpenJCockpit production environment (VM/VPS). Copy to deploy/compose/.env (gitignored), replace EVERY
# value, then run deploy/scripts/validate-env.sh. Never commit the filled-in file; keep it 0600 and back it
# up separately from the database backups (deploy/scripts/backup.sh does NOT include it).
#
# Generate secrets with:   openssl rand -base64 36 | tr -d '/+=' | cut -c1-40
# Generate hex salts with: openssl rand -hex 8      (exactly 16 hex characters)
#
# Every value below is a placeholder that validate-env.sh and the services' ProductionConfigGuard reject.

# ── Release ───────────────────────────────────────────────────────────────────────────────────────────
OPENJCOCKPIT_REGISTRY=ghcr.io/openjcockpit
# Immutable release tag (e.g. v1.4.2 or a git SHA) -- never "latest". deploy-compose.sh records it for rollback.
OPENJCOCKPIT_IMAGE_TAG=__REQUIRED__

# ── Public endpoints (DNS A/AAAA records must point at this host; caddy obtains TLS certificates) ──────
OPENJCOCKPIT_HOST=__REQUIRED__          # e.g. cockpit.example.com
KEYCLOAK_HOST=__REQUIRED__              # e.g. auth.example.com
ACME_EMAIL=__REQUIRED__

# ── Tenant of this deployment (agent bindings, A2A token claim) ───────────────────────────────────────
AGENT_WORKFLOWS_TENANT=__REQUIRED__     # e.g. acme

# ── PostgreSQL ────────────────────────────────────────────────────────────────────────────────────────
POSTGRES_SUPERUSER=__REQUIRED__
POSTGRES_SUPERUSER_PASSWORD=__REQUIRED__
KEYCLOAK_DB_PASSWORD=__REQUIRED__
OPENJCOCKPIT_DB_PASSWORD=__REQUIRED__
EMBABEL_DB_PASSWORD=__REQUIRED__
LITELLM_DB_PASSWORD=__REQUIRED__

# ── Keycloak bootstrap admin (temporary: create a named admin, then disable this one; see runbook) ────
KC_BOOTSTRAP_ADMIN_USERNAME=__REQUIRED__
KC_BOOTSTRAP_ADMIN_PASSWORD=__REQUIRED__

# ── Keycloak service-client secrets ───────────────────────────────────────────────────────────────────
A2A_CLIENT_SECRET=__REQUIRED__
GIT_MCP_CLIENT_SECRET=__REQUIRED__
AI_CONTROL_CLIENT_SECRET=__REQUIRED__
AGENT_SERVICE_CLIENT_SECRET=__REQUIRED__
AGENT_RUNTIME_CLIENT_SECRET=__REQUIRED__

# ── LiteLLM gateway (rotating LITELLM_SALT_KEY makes stored credentials unreadable) ───────────────────
LITELLM_MASTER_KEY=__REQUIRED__         # must start with sk-
LITELLM_SALT_KEY=__REQUIRED__
LITELLM_VIRTUAL_KEY=__REQUIRED__        # must start with sk-
LITELLM_A2A_KEY=__REQUIRED__            # must start with sk-
LITELLM_AI_CONTROL_KEY=__REQUIRED__     # must start with sk-
LITELLM_AGENT_SERVICE_KEY=__REQUIRED__  # must start with sk-

# ── LLM providers ─────────────────────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=__REQUIRED__            # Ollama (or compatible) endpoint reachable from the host; use TLS or a private network
OLLAMA_MODEL=__REQUIRED__               # e.g. qwen3.6:27b
OPENAI_API_KEY=__REQUIRED__

# ── Application encryption and signing ────────────────────────────────────────────────────────────────
ENCRYPTION_SECRET=__REQUIRED__          # >= 32 characters; encrypts stored Git credentials
ENCRYPTION_SALT=__REQUIRED__            # 16 hex characters
A2A_SERVICE_ENCRYPTION_SECRET=__REQUIRED__
A2A_SERVICE_ENCRYPTION_SALT=__REQUIRED__   # 16 hex characters
SPEC_QUEUE_RUNNER_TOKEN_SECRET=__REQUIRED__  # >= 32 bytes, identical for both services

# ── Operations ────────────────────────────────────────────────────────────────────────────────────────
BACKUP_DIR=/var/backups/openjcockpit
BACKUP_RETENTION_DAYS=14
METRICS_TEXTFILE_DIR=/var/lib/openjcockpit/metrics
