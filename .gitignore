# Node
node_modules/
dist/

# Java / Maven
target/

# IDE
.idea/
*.iml

# Env
.env
!.env.example

# OS
.DS_Store

# TypeScript incremental build info
*.tsbuildinfo

# Docker Compose auto-merges this filename by convention; committing it would make
# any opt-in overlay (e.g. docker-compose.local-marketplace.yml) default-on.
docker-compose.override.yml
# Local (per-developer) Keycloak users — never commit personal accounts/passwords
infrastructure/keycloak/local-users/*.local.json

# Playwright e2e harness (frontend/e2e/) — storage state contains live Keycloak SSO
# cookies, and report/artifact directories can contain bearer tokens (see
# frontend/e2e/README.md). Never commit any of these.
frontend/e2e/.auth/
frontend/e2e/test-results/
frontend/e2e/playwright-report/
frontend/e2e/blob-report/

# Nx local cache and workspace data
frontend/.nx/cache
frontend/.nx/workspace-data

# Nx cache and workspace data when run from the repo root
.nx/cache
.nx/workspace-data

# Vite cache
.vite/

# PR description scratch files
PR_*.md
