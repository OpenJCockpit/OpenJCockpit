# Node
node_modules/
dist/

# Frontend CI checkout (the e2e workflow checks the OpenJCockpit-frontend repo out here)
.frontend/

# Stray Nx cache when Nx is run from the repository root
.nx/

# Java / Maven
target/

# IDE
.idea/
*.iml

# Env
.env
!.env.example

# OS
.DS_Store

# TypeScript incremental build info
*.tsbuildinfo

# Docker Compose auto-merges this filename by convention; committing it would make
# any opt-in overlay (e.g. docker-compose.local-marketplace.yml) default-on.
docker-compose.override.yml
# Local (per-developer) Keycloak users — never commit personal accounts/passwords
infrastructure/keycloak/local-users/*.local.json

# PR description scratch files
PR_*.md

# Test coverage reports
coverage/
.playwright-mcp/

# Production deployment: filled-in environment files, rendered secrets, backups and deploy history
deploy/**/.env
deploy/**/*.env
!deploy/**/*.env.example
deploy/k8s/**/secret.yaml
deploy/compose/.deploy-history
*.dump
